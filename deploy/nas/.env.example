# Copy to .env next to docker-compose.yml and fill in.

# The URL a browser uses to reach Twenty. Must include the port you publish.
# Wrong value here is the single most common cause of a broken instance:
# login redirects and asset URLs are built from it.
SERVER_URL=http://192.168.1.50:3000

# Host port. Change if something on the NAS already uses 3000, and keep
# SERVER_URL in step with it.
HOST_PORT=3000

# openssl rand -base64 32
# Back this up. Losing it makes every encrypted value unreadable.
ENCRYPTION_KEY=

# Letters and digits only. Special characters break the connection URL.
PG_DATABASE_PASSWORD=
PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default

# Pin this to a released version once the instance holds real data.
TAG=latest
